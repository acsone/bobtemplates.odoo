{
    'name': '{{{ addon.name_camelwords }}}',
    'summary': """{{{ addon.summary }}}""",
    'version': '{{{ addon.version }}}',
{{% if odoo.licence == "AGPL" %}}
    'license': 'AGPL-3',
{{% elif odoo.licence == "LGPL" %}}
    'license': 'LGPL-3',
{{% elif odoo.licence == "OTHER" %}}
    'license': 'Other proprietary',
{{% endif %}}
    'author': '{{{ copyright.name }}}{{% if addon.oca %}},Odoo Community Association (OCA){{% endif %}}',
{{% if copyright.website %}}
    'website': '{{{ copyright.website }}}',
{{% endif %}}
    'depends': [
    ],
    'data': [
    ],
    'demo': [
    ],
}
